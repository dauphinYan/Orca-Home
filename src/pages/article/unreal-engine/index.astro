---
import LanguageSwitch from '../../../components/LanguageSwitch.astro';
import '../../../styles/global.css';
import '../../../styles/article-sidebar.css';
import '../../../styles/article-frame.css';
import '../../../styles/knowledge-index.css';
import { getCollection } from 'astro:content';
import KnowledgeTree from '../../../components/KnowledgeTree.astro';
import ArticleSidebar from '../../../components/ArticleSidebar.astro';
import { buildUnrealDocsArticles, buildUnrealDocsTree, unrealDocsHubPath } from '../../../data/unreal-docs';

const [cppEntries, gameplayEntries] = await Promise.all([
  getCollection('unrealCpp'),
  getCollection('gameplaySystems'),
]);
const articles = buildUnrealDocsArticles(cppEntries, gameplayEntries)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'zh-CN'));
const navigationTree = buildUnrealDocsTree(cppEntries, gameplayEntries);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Unreal Engine 5.8 官方文档中文导读专区，涵盖 C++ 编程与游戏性系统。" />
    <meta name="theme-color" content="#f7f6f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171a16" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <title>虚幻引擎官方文档 · 中文专区 - Orca丶</title>
  </head>
  <body class="page-with-paint-splashes">
    <header><div class="nav-inner"><nav aria-label="主导航"><a href="/#home">首页</a><a href="/#projects">作品</a><a href="/article/" class="active" aria-current="page">文章</a><a href="/#about">关于</a><a href="/#contact">联系</a></nav><LanguageSwitch /></div></header>
    <main class="knowledge-page">
      <a class="back-link" href="/article/">← 返回文章列表</a>
      <section class="knowledge-hero">
        <p class="knowledge-eyebrow">UNREAL ENGINE 5.8 / OFFICIAL DOCS GUIDE</p>
        <h1>虚幻引擎官方文档<br /><span>中文专区</span></h1>
        <p>以官方文档目录为骨架，用中文导读串起 Unreal Engine 的关键概念。当前收录 C++ 编程与游戏性系统；每篇均附原文、版本与核对日期。</p>
      </section>
      <section class="knowledge-layout" aria-label="虚幻引擎官方文档知识库">
        <ArticleSidebar label="OFFICIAL DOCUMENTS" title="官方目录" ariaLabel="虚幻引擎官方文档目录" kind="knowledge" placement="embedded" mobileDrawer>
          <nav id="knowledge-doc-nav" aria-label="虚幻引擎官方文档目录"><KnowledgeTree nodes={navigationTree} currentSlug="" urlFor={() => `${unrealDocsHubPath}/`} /></nav>
        </ArticleSidebar>
        <div class="knowledge-content">
          <label class="knowledge-search"><span class="sr-only">搜索专区内容</span><input type="search" placeholder="搜索标题、摘要或正文术语…" data-knowledge-search /></label>
          <p class="knowledge-results" data-knowledge-results aria-live="polite">已收录 {articles.length} 篇导读</p>
          <div class="knowledge-cards" data-knowledge-cards>
            {articles.map(article => <article class="knowledge-card" data-knowledge-card={article.href} data-search={`${article.data.title} ${article.data.description}`}>
              <p>{article.section} · UE {article.data.engineVersion} · 已核对 {article.data.reviewedAt.toLocaleDateString('zh-CN')}</p>
              <h2 lang="zh-CN" data-i18n-ignore><a href={article.href}>{article.data.title}</a></h2>
              <p class="knowledge-card-description" lang="zh-CN" data-i18n-ignore>{article.data.description}</p>
              <div><span>{article.data.tags.join(' · ')}</span><a href={article.href}>阅读导读 ↗</a></div>
            </article>)}
          </div>
        </div>
      </section>
    </main>
    <footer class="blog-footer"><span>内容为中文学习导读，官方文档版权归 Epic Games 所有。</span><span>© 2026 Orca丶</span></footer>
    <script>
      import { initArticleReader } from '../../../scripts/article-reader';
      import { initKnowledgeTree } from '../../../scripts/knowledge-tree';
      initArticleReader();
      initKnowledgeTree();
    </script>
    <script>
      import { initKnowledgeSearch } from '../../../scripts/knowledge-search';
      initKnowledgeSearch();
    </script>
  </body>
</html>
