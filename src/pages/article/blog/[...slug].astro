---
import BlogDates from '../../../components/BlogDates.astro';
import { blogTagLabel } from '../../../data/blog-tags';
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import ArticleDetailLayout from '../../../layouts/ArticleDetailLayout.astro';
import ArticleOutlineNav from '../../../components/ArticleOutlineNav.astro';

interface Props { post: CollectionEntry<'blog'>; }

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const englishPost = await getEntry('blogEnglish', post.id);
const EnglishContent = englishPost && !englishPost.data.draft ? (await render(englishPost)).Content : undefined;
---
<ArticleDetailLayout
  pageTitle={`${post.data.title} - Orca丶的博客`}
  title={post.data.title}
  description={post.data.description}
  eyebrow={blogTagLabel(post.data.tags[0] ?? 'DEVLOG')}
  footerNote="本网站基于 Astro 构建"
  footerCopyright="© 2026 Orca丶. 保留所有权利。"
>
  <ArticleOutlineNav slot="leftSidebar" side="left" />
  <a slot="preamble" class="back-link" href="/article/">← 返回文章列表</a>
  <div slot="metadata">
    <p class="post-dates"><BlogDates post={post} /></p>
    {post.data.tags.length > 0 && <ul class="post-tags" aria-label="文章标签">{post.data.tags.map(tag => <li>{blogTagLabel(tag)}</li>)}</ul>}
  </div>
  <Content />
  {EnglishContent && <EnglishContent slot="english" />}
</ArticleDetailLayout>
