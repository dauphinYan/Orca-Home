---
import Icon from '../../components/Icon.astro';
import BlogDates from '../../components/BlogDates.astro';
import { blogTagLabel } from '../../data/blog-tags';
import ArticleListRow from '../../components/ArticleListRow.astro';
import LanguageSwitch from '../../components/LanguageSwitch.astro';

import { blogDate as formatDate, blogUpdatedAt } from '../../data/blog-dates';
import { buildSourceReadingSection, sourceReadingHighlights, sourceReadingPath } from '../../data/source-reading';
import '../../styles/global.css';
import '../../styles/article-index.css';
import '../../styles/article-overview.css';
import { getCollection } from 'astro:content';

const blogPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const unrealCpp = await getCollection('unrealCpp', ({ data }) => !data.draft);
const gameplaySystems = await getCollection('gameplaySystems', ({ data }) => !data.draft);
const unrealArticleCount = unrealCpp.length + gameplaySystems.length;
const totalArticleCount = blogPosts.length + unrealArticleCount;
const latestUpdatedAt = blogPosts.reduce<Date | undefined>((latest, post) => {
  const updatedAt = blogUpdatedAt(post);

  return !latest || updatedAt > latest ? updatedAt : latest;
}, undefined);
const sourceReading = buildSourceReadingSection(blogPosts);

const highlightedPosts = sourceReadingHighlights(sourceReading.articles);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Orca丶的文章与技术专区：游戏开发记录、Unreal Engine、C++ 与创作思考。" />
    <meta name="theme-color" content="#f7f6f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171a16" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>文章 - Orca丶</title>
  </head>
  <body class="page-with-paint-splashes">
    <header>
      <div class="nav-inner">
        <nav aria-label="主导航">
          <a href="/#home">首页</a>
          <a href="/#projects">项目</a>
          <a href="/article/" class="active" aria-current="page">文章</a>
          <a href="/#about">关于</a>
          <a href="/#contact">联系</a>
        </nav><LanguageSwitch />
      </div>
    </header>

    <main class="article-index article-overview">
      <section class="overview-hero" aria-labelledby="article-page-title">
        <div class="overview-intro">
          <h1 id="article-page-title">文章<span aria-hidden="true">′</span></h1>
          <p>Unreal Engine 源码解读与游戏开发实践</p>
        </div>
        <p class="overview-stats">
          <span data-i18n-en={`${totalArticleCount} articles`}>共 {totalArticleCount} 篇文章</span>
          {latestUpdatedAt && <span><span>最近更新</span> <time datetime={latestUpdatedAt.toISOString()}>{formatDate(latestUpdatedAt)}</time></span>}
        </p>
      </section>

      <section class="overview-section" aria-labelledby="recommended-title">
        <div class="overview-section-heading">
          <h2 id="recommended-title">推荐阅读</h2>
          <a href={sourceReadingPath}>查看全部源码解读 ↗</a>
        </div>
        {highlightedPosts.length > 0 ? (
          <ul class="article-list">
            {highlightedPosts.map(post => <ArticleListRow post={post} />)}
          </ul>
        ) : <p class="article-empty">源码解读文章正在整理中。</p>}
      </section>

      <section class="article-section" aria-labelledby="featured-sections-title">
        <div class="article-section-heading">
          <p>FEATURED SECTIONS</p>
          <h2 id="featured-sections-title">专题专区</h2>
        </div>
        <div class="featured-sections-grid">
          <a class="featured-section-card featured-section-card--source" href={sourceReadingPath}>
            <div class="featured-section-copy">
              <p class="featured-section-label">UNREAL ENGINE / SOURCE READING</p>
              <h3>虚幻引擎<br />源码解读专区</h3>
              <p>从源码理解引擎机制，记录关键流程与设计思路。</p>
            </div>
            <div class="featured-section-meta">
              <span data-i18n-en={`${sourceReading.count} articles published`}>已收录 {sourceReading.count} 篇解读</span>
              {sourceReading.latestPublishedAt && <span><span>最近发布</span> <time datetime={sourceReading.latestPublishedAt.toISOString()}>{formatDate(sourceReading.latestPublishedAt)}</time></span>}
              <strong>进入专区 ↗</strong>
            </div>
            <span class="featured-section-stamp">专区</span>
            <span class="featured-section-code" aria-hidden="true">C++</span>
          </a>
          <a class="featured-section-card" href="/article/unreal-engine/">
            <div class="featured-section-copy">
              <p class="featured-section-label">UNREAL ENGINE 5.8 / OFFICIAL DOCS GUIDE</p>
              <h3>虚幻引擎官方文档<br />中文专区</h3>
              <p>以官方文档目录为骨架，用中文导读串起 C++ 编程与游戏性系统的关键概念。</p>
            </div>
            <div class="featured-section-meta">
              <span data-i18n-en={`${unrealArticleCount} Chinese guides published`}>已收录 {unrealArticleCount} 篇导读</span>
              <strong>进入专区 ↗</strong>
            </div>
            <span class="featured-section-stamp">专区</span>
            <span class="featured-section-code" aria-hidden="true">UE<br />5.8</span>
          </a>
        </div>
      </section>

      <section class="article-section latest-section" aria-labelledby="latest-title">
        <div class="article-section-heading">
          <p>LATEST ARTICLES</p>
          <h2 id="latest-title">全部文章</h2>
        </div>
        {blogPosts.length > 0 ? (
          <div class="latest-grid">
            {blogPosts.map(post => (
              <a class="latest-card" href={`/article/blog/${post.id}/`}>
                <p class="article-card-label">{post.data.tags.map(blogTagLabel).join(' / ') || 'DEVLOG'}</p>
                <h3>{post.data.title}</h3>
                {post.data.description.trim() && <p class="article-card-description">{post.data.description}</p>}
                <div class="article-card-meta">
                  <BlogDates post={post} />
                  <span>阅读全文 ↗</span>
                </div>
                <span class="round-arrow" aria-hidden="true"><Icon name="arrow" /></span>
              </a>
            ))}
          </div>
        ) : (
          <p class="article-empty">第一篇文章正在准备中。</p>
        )}
      </section>
    </main>

    <footer class="article-index-footer">
      <a href="/#home">← 返回首页</a>
      <span>© 2026 Orca丶</span>
    </footer>
  </body>
</html>
