---
import LanguageSwitch from '../../components/LanguageSwitch.astro';
import '../../styles/lockknock.css';
import MediaViewer from '../../components/MediaViewer.astro';
import { projects } from '../../data/portfolio';
import cover from '../../assets/projects/lock-knock/cover-horizontal.jpg?url';
import poster from '../../assets/projects/lock-knock/cover-vertical.png?url';
import title from '../../assets/projects/lock-knock/title.png?url';
import scene from '../../assets/projects/lock-knock/lock-knock-screenshot-1.png?url';
import creature from '../../assets/projects/lock-knock/lock-knock-screenshot-2.png?url';
import lantern from '../../assets/projects/lock-knock/lock-knock-screenshot-3.png?url';
import corridor from '../../assets/projects/lock-knock/lock-knock-screenshot-4.png?url';
import chamber from '../../assets/projects/lock-knock/lock-knock-screenshot-5.png?url';
const project = projects.find(project => project.key === 'lockknock')!;
const screenshots = [scene, creature, lantern, corridor, chamber];
const promotionalVideo = 'https://www.bilibili.com/video/BV1SwGN68EPs';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`洛克的迷宫 — ${project.description} Orca丶的游戏项目。`} />
    <meta name="theme-color" content="#101011" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>洛克的迷宫 · Lock Knock — Orca丶</title>
  </head>
  <body>
    <header class="game-header">
      <a class="author-logo" href="/">舞台装置<span>GrewGame</span><small>独立游戏开发</small></a>
      <nav aria-label="专题导航"><a href="#about-game">游戏介绍</a><a href="#gallery">游戏画面</a><a href="/#projects">返回作品集 ↗</a></nav><LanguageSwitch />
    </header>
    <main>
      <section class="game-hero" aria-labelledby="game-title">
        <img class="hero-cover" src={cover} alt="提灯的角色站在门口，身后暗处浮现触手" fetchpriority="high" />
        <div class="hero-shade"></div>
        <div class="game-hero-content">
          <p class="eyebrow">AN INDIE GAME BY ORCA</p>
          <h1 id="game-title"><img src={title} alt="洛克的迷宫 · Lock Knock" /></h1>
          <p class="hero-quote">门后，是未知。<br />而你，必须向前。</p>
          <div class="hero-actions"><a class="gold-button" href="#about-game">窥见迷宫 <span>↘</span></a></div>
        </div>
        <div class="hero-bottom"><span>UNREAL ENGINE · 探索 / 迷宫 / 角色扮演</span><a href="#about-game">向下探索 ↓</a></div>
      </section>
      <section class="game-about game-section" id="about-game">
        <div class="poster-frame"><img src={poster} alt="洛克的迷宫竖版游戏海报" loading="lazy" /><span>LOCK KNOCK / 01</span></div>
        <div class="about-copy"><p class="eyebrow">01 / INTO THE UNKNOWN</p><h2>踏入迷宫，<br /><em>直面未知。</em></h2><p class="intro">{project.description}</p><p class="subtle">一场围绕探索与逃生展开的冒险。诡异的环境、潜伏的恶灵与怪物，共同构成这座迷宫的危险。</p><ul class="game-tags">{project.tags.map(tag => <li>{tag}</li>)}</ul><dl class="game-facts"><div><dt>舞台装置</dt><dd>GrewGame</dd></div><div><dt>开发引擎</dt><dd>Unreal Engine</dd></div><div><dt>游戏风格</dt><dd>克苏鲁 · 诡异</dd></div></dl></div>
      </section>
      <section class="gallery-section game-section" id="gallery">
        <div class="section-heading"><div><p class="eyebrow">02 / GLIMPSES OF THE MAZE</p><h2>来自迷宫的切片</h2></div><div class="gallery-controls"><button type="button" data-gallery-direction="-1" aria-label="查看上一张切片">←</button><button type="button" data-gallery-direction="1" aria-label="查看下一张切片">→</button></div></div>
        <div class="gallery-track" aria-label="游戏画面切片">{screenshots.map((image, index) => <figure><button class="screenshot-button" data-image={image} data-index={index} aria-label={`放大查看迷宫切片 ${index + 1}`}><img src={image} alt={`洛克的迷宫游戏画面 ${index + 1}`} loading="lazy" /><span class="zoom-mark" aria-hidden="true">↗</span></button></figure>)}</div>
      </section>
      <section class="game-follow"><p class="eyebrow">THE JOURNEY CONTINUES</p><h2>在微光中，继续前行。</h2><p>关注 GrewGame，了解更多游戏与开发内容。</p><div class="follow-actions"><a class="gold-button" href={promotionalVideo} target="_blank" rel="noopener noreferrer">前往 Bilibili ↗</a></div></section>
    </main>
    <footer class="game-footer"><span>本网站基于 Astro 构建</span><span>© 2026 Orca丶. 保留所有权利。</span></footer>
    <MediaViewer />
    <script>
      const galleryTrack = document.querySelector<HTMLElement>('.gallery-track')!;
      document.querySelectorAll<HTMLButtonElement>('[data-gallery-direction]').forEach(button => {
        button.addEventListener('click', () => {
          const direction = Number(button.dataset.galleryDirection);
          const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          galleryTrack.scrollBy({ left: direction * galleryTrack.clientWidth * 0.85, behavior: reducedMotion ? 'auto' : 'smooth' });
        });
      });
    </script>
  </body>
</html>
