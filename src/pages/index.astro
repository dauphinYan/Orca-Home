---
import { blogTagLabel } from '../data/blog-tags';
import '../styles/global.css';
import '../styles/portfolio.css';
import Icon from '../components/Icon.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, projects } from '../data/portfolio';
import { blogPlaceholders } from '../data/blog';
import { getCollection } from 'astro:content';
import unrealIcon from '../assets/icons/unreal.png?url';
// Legacy source images lack metadata that Astro can decode, so retain bundled URLs.
import cppIcon from '../assets/icons/cpp.png?url';
import heroArt from '../assets/home/hero-art.webp?url';
const skills = [
  { name: 'Unreal Engine', image: unrealIcon, icon: null },
  { name: 'C++', image: cppIcon, icon: null },
  { name: '其他', image: null, icon: 'tools' },
];
const blogPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const remainingBlogCards = Math.max(0, 4 - blogPosts.length);

---
<!doctype html>
<html lang="zh-CN">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content="Orca丶 的独立游戏开发作品集。Unreal Engine、C++、游戏设计，把想法变成可玩的世界。" /><meta name="theme-color" content="#f7f6f0" media="(prefers-color-scheme: light)" /><meta name="theme-color" content="#171a16" media="(prefers-color-scheme: dark)" /><link rel="preload" href={heroArt} as="image" type="image/webp" /><title>Orca丶 — 把想法，变成可玩的世界</title><link rel="icon" href="/favicon.svg" type="image/svg+xml" /></head>
 <body class="page-with-paint-splashes">
   <header class="home-header"><div class="nav-inner"><nav aria-label="主导航"><a href="#home" class="active">首页</a><a href="#projects">项目</a><a href="/article/">文章</a><a href="#about">关于</a><a href="#contact">联系</a></nav><LanguageSwitch /></div></header>
  <main>
   <section id="home" class="hero"><div class="hero-art" aria-hidden="true"></div><div class="hero-copy"><h1><span class="hello">你好，我是</span><span class="name">Orca丶</span></h1><p class="profession">Unreal Engine / C++ / 游戏开发</p><p class="tagline">把想法，变成可玩的世界。</p></div><span class="hero-spark" aria-hidden="true">✦</span></section>
    <section id="skills" class="content-row skills"><div class="section-title"><h2>技能<span>′</span></h2><p>SKILLS <b>↗</b></p></div><div class="skill-grid">{skills.map(skill => <div class="skill-card">{skill.image ? <img class="skill-logo" src={skill.image} width="60" height="60" alt={`${skill.name} 图标`} /> : <Icon name={skill.icon!} />}<h3>{skill.name}</h3></div>)}</div></section>
    <section id="projects" class="content-row projects"><div class="section-title"><h2>项目展示<span>′</span></h2><p>PROJECTS <b>↗</b></p></div><div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div></section>
     <section id="articles" class="content-row blog"><div class="section-title article-section-title"><h2>文章<span>′</span></h2><p>ARTICLES <b>↗</b></p><a class="article-index-link" href="/article/">查看全部文章 ↗</a></div><div class="blog-grid"><a class="blog-card blog-card-published knowledge-feature-card" href="/article/unreal-engine/"><p class="blog-card-label">UNREAL ENGINE / OFFICIAL DOCS</p><h3>虚幻引擎官方文档 · 中文专区</h3><p class="blog-card-description">按官方目录整理的 UE 5.8 中文学习导读，已收录 C++ 与游戏性系统内容。</p><span class="blog-card-read">进入专区 ↗</span><span class="round-arrow" aria-hidden="true"><Icon name="arrow" /></span></a>{blogPosts.slice(0, 3).map(post => <a class="blog-card blog-card-published" href={`/article/blog/${post.id}/`}><p class="blog-card-label">{blogTagLabel(post.data.tags[0] ?? 'DEVLOG')}</p><h3>{post.data.title}</h3><p class="blog-card-description">{post.data.description}</p><time datetime={post.data.publishedAt.toISOString()}>{post.data.publishedAt.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}</time><span class="blog-card-read">阅读全文 ↗</span><span class="round-arrow" aria-hidden="true"><Icon name="arrow" /></span></a>)}{blogPlaceholders.slice(0, Math.max(0, 3 - blogPosts.length)).map(post => <article class="blog-card blog-card-placeholder"><p class="blog-card-label">{post.label}</p><h3>{post.title}</h3><p class="blog-card-description">{post.description}</p><span class="blog-card-status">即将发布</span></article>)}</div></section>
     <section id="about" class="content-row about"><div class="section-title"><h2>关于我<span>′</span></h2><p>ABOUT <b>↗</b></p></div><div class="bio profile-bio"><img class="avatar" src={profile.avatar} width="88" height="88" alt="Orca丶的头像" loading="lazy" /><div><p class="bio-name">我叫 {profile.name}。</p><p>{profile.abstract}</p></div></div><p class="manifesto">热爱游戏，<br/><span>持续创造。</span></p></section>
  </main>
   <footer id="contact" class="content-row contact"><div class="section-title"><h2>联系我<span>′</span></h2><p>CONTACT <b>↗</b></p></div><div class="contact-links"><a href={`mailto:${profile.email}`}><Icon name="mail" /><span>{profile.emailLabel}</span></a><a href={`mailto:${profile.gmail}`}><span>Gmail</span></a><a href={profile.bilibili}><Icon name="tv" /><span>Bilibili<small>{profile.name}</small></span></a><a href={profile.github}><Icon name="github" /><span>GitHub<small>dauphinYan</small></span></a></div><div class="contact-meta"><p>本网站基于 Astro 构建</p><p>© 2026 Orca丶. 保留所有权利。</p></div></footer>
  <script>
   const links = document.querySelectorAll('nav a');
   const sectionHref = (id: string) => id === 'articles' ? '/article/' : `#${id}`;
   const observer = new IntersectionObserver(entries => { entries.forEach(entry => { if(entry.isIntersecting) links.forEach(link => link.classList.toggle('active', link.getAttribute('href') === sectionHref(entry.target.id))); }); }, { threshold: 0, rootMargin: '-10% 0px -65% 0px' });
    ['home','projects','articles','about','contact'].forEach(id => observer.observe(document.getElementById(id)!));
  </script>
 </body>
</html>
<style>
  :global(html[lang="en"]) .section-title h2 { font-size: clamp(28px, 3vw, 43px); white-space: normal; }

  :global(html[lang="en"]) .profession { max-width: 100%; width: fit-content; }

  :global(html[lang="en"]) .tagline { max-width: 100%; width: fit-content; white-space: normal; }

  @media (max-width: 720px) {
    :global(html[lang="en"]) .profession { margin-left: 0; font-size: clamp(12px, 3.5vw, 17px); }

    :global(html[lang="en"]) .tagline { margin-left: 0; font-size: clamp(17px, 4.5vw, 22px); }
  }
</style>
