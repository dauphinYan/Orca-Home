---
import type { CollectionEntry } from 'astro:content';
import BlogDates from './BlogDates.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  topics: string;
}

const { post, topics } = Astro.props;
---
<li>
  <a class="article-list-row" href={`/article/blog/${post.id}/`}>
    <div class="article-list-copy">
      <h3 lang="zh-CN" data-i18n-ignore>{post.data.title}</h3>
      {post.data.description.trim() && <p class="article-list-summary" lang="zh-CN" data-i18n-ignore>{post.data.description}</p>}
    </div>
    <div class="article-list-meta">
      <span class="article-list-topics">{topics}</span>
      <BlogDates post={post} />
    </div>
  </a>
</li>
