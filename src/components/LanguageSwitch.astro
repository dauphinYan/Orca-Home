---
import { getPageTranslations } from '../i18n/pages';

const translations = await getPageTranslations(Astro.url.pathname);
---
{translations && <button data-language-switch data-translations={JSON.stringify(translations)} type="button" aria-label="Switch to English" title="Switch to English" lang="en" hidden>
  En
</button>}

<style>
  button {
    margin-left: auto;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: inherit;
    font-size: 20px;
    font-weight: 900;
    line-height: inherit;
    cursor: pointer;
  }

  button[hidden] { display: none; }

  button:hover { color: var(--pink); }

  button:focus-visible { outline: 2px solid var(--pink); outline-offset: 3px; }

  @media (max-width: 840px) {
    :global(.nav-inner:has([data-language-switch])) { justify-content: flex-end; gap: 0; }

    :global(.nav-inner:has([data-language-switch]) nav) { margin-left: auto; gap: 0; }

    :global(.nav-inner:has([data-language-switch]) nav a) { min-width: 44px; box-sizing: border-box; padding-inline: 8px; text-align: center; white-space: nowrap; }

    button { margin-left: 0; }
  }

  @media (max-width: 720px) {
    button { font-size: 15px; }
  }

  @media (max-width: 420px) {
    :global(.nav-inner:has([data-language-switch])) { padding-inline: 12px; }

    :global(.nav-inner:has([data-language-switch]) nav a) { width: 44px; padding-inline: 0; }

  }

  /* English labels need their own spacing; Chinese keeps the existing layout.
     The language switch updates <html lang>, including the saved preference. */
  :global(html:lang(en) .nav-inner > nav) { gap: 36px; }

  :global(html:lang(en) .nav-inner > nav > a) { white-space: nowrap; }

  @media (max-width: 840px) {
    :global(html:lang(en) .nav-inner:has([data-language-switch])) { gap: 20px; }

    :global(html:lang(en) .nav-inner:has([data-language-switch]) > nav) { gap: 16px; }
  }

  @media (max-width: 720px) {
    :global(html:lang(en) .nav-inner:has([data-language-switch])) { gap: 12px; }

    :global(html:lang(en) .nav-inner:has([data-language-switch]) > nav) {
      flex: 1;
      min-width: 0;
      justify-content: space-between;
      gap: 8px;
    }

    :global(html:lang(en) .nav-inner:has([data-language-switch]) > nav > a) {
      width: auto;
      min-width: 0;
      padding-inline: 2px;
      font-size: clamp(12px, 3.2vw, 15px);
    }
  }

  @media (max-width: 420px) {
    :global(html:lang(en) .nav-inner:has([data-language-switch])) { gap: 8px; }

    :global(html:lang(en) .nav-inner:has([data-language-switch]) > nav) { gap: 4px; }
  }
</style>

<script>
  import { initPageLanguage } from '../scripts/page-language';

  initPageLanguage();
</script>
