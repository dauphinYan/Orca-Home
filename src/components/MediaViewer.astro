---
import '../styles/media-viewer.css';
---
<dialog class="media-viewer" aria-label="图片与图表查看器" data-media-viewer>
  <button class="media-viewer-close media-viewer-fullscreen" type="button" data-viewer-action="fullscreen" aria-label="全屏查看" aria-pressed="false" title="全屏查看">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
      <path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" />
    </svg>
  </button>
  <button class="media-viewer-close" type="button" data-viewer-action="close" aria-label="关闭查看器" autofocus>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
      <path d="m6 6 12 12M18 6 6 18" />
    </svg>
  </button>
  <div class="media-viewer-stage" data-viewer-stage><div class="media-viewer-content" data-viewer-content></div></div>
  <div class="media-viewer-zoom" role="group" aria-label="图片缩放">
    <button type="button" data-viewer-action="zoom-out" aria-label="缩小图片" title="缩小图片">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path d="M5 12h14" />
      </svg>
    </button>
    <output class="media-viewer-scale" data-viewer-scale aria-label="缩放比例">100%</output>
    <button type="button" data-viewer-action="zoom-in" aria-label="放大图片" title="放大图片">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path d="M5 12h14M12 5v14" />
      </svg>
    </button>
  </div>
</dialog>
<script>
  import { initMediaViewer } from '../scripts/media-viewer';

  initMediaViewer();
</script>
