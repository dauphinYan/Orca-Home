---
import type { projects } from '../data/portfolio';
import Icon from './Icon.astro';
interface Props { project: (typeof projects)[number] }
const { project } = Astro.props;
const Tag = project.href ? 'a' : 'button';
const dialogId = `project-${project.key}`;
---
<article class={`portfolio-card ${project.key}`} data-motion-reveal>
  <Tag class="project-media" href={project.href ?? undefined} type={project.href ? undefined : 'button'} data-project-dialog={project.href ? undefined : dialogId} aria-haspopup={project.href ? undefined : 'dialog'} aria-controls={project.href ? undefined : dialogId} aria-label={`查看${project.title}详情`}>
    {project.image ? <img src={project.image} alt="" loading="lazy" /> : <span class="work-in-progress" aria-hidden="true"><span class="world-orbit"></span></span>}
    {project.status && <span class="project-badge">{project.status}</span>}
    <h3 class="project-title">{project.title}</h3>
    <span class="round-arrow" aria-hidden="true"><Icon name="arrow" /></span>
  </Tag>
  {!project.href && <dialog id={dialogId} class="project-dialog" data-motion-dialog aria-labelledby={`${dialogId}-title`} aria-describedby={`${dialogId}-description`}>
    <button class="close-dialog" type="button" aria-label="关闭详情" autofocus>×</button>
    <h2 id={`${dialogId}-title`}>{project.title}</h2>
    <p id={`${dialogId}-description`}>{project.description}</p>
    <ul class="project-tags" aria-label="作品标签">{project.tags.map(tag => <li>{tag}</li>)}</ul>
    {project.links && <ul class="project-links">
      {project.links.map(link => <li>
        <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
        {link.password && <span><span>密码：</span><code>{link.password}</code></span>}
      </li>)}
    </ul>}
  </dialog>}
</article>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-project-dialog]').forEach(button => {
    button.addEventListener('click', () => {
      const dialog = document.getElementById(button.dataset.projectDialog!) as HTMLDialogElement;
      dialog.showModal();
    });
  });
  document.querySelectorAll<HTMLDialogElement>('.project-dialog').forEach(dialog => {
    dialog.querySelector<HTMLButtonElement>('.close-dialog')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', event => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
    });
  });
</script>
